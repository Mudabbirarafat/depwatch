# Copy to .env and adjust. Nothing here is secret yet; the GitHub source in
# week two will need a token, which belongs in the platform, not in the repo.

# sqlite needs no services; the compose file supplies a Postgres URL instead.
DATABASE_URL=sqlite:///depwatch.db
# DATABASE_URL=postgresql+psycopg://depwatch:depwatch@localhost:5432/depwatch

RAW_DIR=data/raw
NPM_REGISTRY=https://registry.npmjs.org

REQUEST_TIMEOUT=20
MAX_CONCURRENCY=8
MAX_RETRIES=4
